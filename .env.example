# Copy to .env and fill in. Do not commit .env.

PORT=3000
# Optional: quiet Node DEP0169 (url.parse) from Express’s parseurl on Node 22+. Also set in vercel.json for production.
# NODE_OPTIONS=--disable-warning=DEP0169

# Your app URL (no trailing slash). Use https in production.
BASE_URL=http://localhost:3000
# Share embed image URL (og:image). Set in Vercel to production domain e.g. https://absurd-apes.vercel.app so link previews show the logo.
# SITE_URL=https://absurd-apes.vercel.app

# Session secret (change in production)
SESSION_SECRET=your-random-secret-at-least-32-chars

# Discord Developer Portal: https://discord.com/developers/applications
# Create an application → OAuth2 → Redirects: add BASE_URL/api/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Team section: bot token to fetch Discord username/avatar by ID. Same Discord app → Bot → Reset Token → copy here.
DISCORD_BOT_TOKEN=
# Raffle announcements: Discord channel ID where the bot posts new raffles and winners. Bot must be in the server (use invite link) and have Send Messages in this channel.
# DISCORD_RAFFLE_CHANNEL_ID=

# Helius (https://dashboard.helius.dev) — for collection supply via DAS getAssetsByGroup
HELIUS_API_KEY=

# Optional: on-chain collection mint addresses for supply + metadata + holders NFT counts.
# Get from Solscan: open any minted NFT → "Collection" field; or from Magic Eden/Helius for the collection.
# ABSURD_ART_APES_COLLECTION_MINT=
# ABSURD_HORIZONS_COLLECTION_MINT=   # Required for Holders table Horizons column (get from Solscan or LaunchMyNFT)

# AAA (project) token mint — used for /api/prices, /api/verify, /api/holders, token chart
# AAA_TOKEN_MINT=

# Birdeye (https://birdeye.so) — for 15m OHLC chart in token section (optional)
# BIRDEYE_API_KEY=

# Raffles: comma-separated Discord user IDs allowed to create raffles (admin panel).
# ADMIN_DISCORD_IDS=123456789,987654321
# Solana wallet address where prize NFTs are sent when a raffle starts.
# PRIZE_WALLET=
# Optional: base58 secret key for PRIZE_WALLET so the server can send the prize NFT to the winner on claim. If unset, winners see "Contact the team".
# PRIZE_WALLET_PRIVATE_KEY=
# Where ticket payments go (SOL/tokens). Defaults to PRIZE_WALLET if unset.
# RAFFLE_TREASURY_WALLET=

# Merch claim packaging fee (~USD → SOL via Jupiter price). Recipient mainnet wallet.
# If unset, defaults to RAFFLE_TREASURY_WALLET then PRIZE_WALLET (same as raffle SOL payments).
# MERCH_PACK_PAYMENT_WALLET=
# MERCH_PACK_FEE_USD=20
# Min fraction of MERCH_PACK_FEE_USD worth when verifying on-chain payment (slippage / price drift).
# MERCH_PACK_PAID_USD_MIN_RATIO=0.94

# Gravemint Custom webhook → POST /api/merch/gravemint-webhook (and optional path token below).
# Auth option A — long random token in URL only (works when Gravemint cannot set headers): openssl rand -hex 32
# Then webhook URL: https://YOUR_DOMAIN/api/merch/gravemint-webhook/<same hex>
# GRAVEMINT_WEBHOOK_URL_TOKEN=
# Auth option B — shared secret: Bearer / X-Webhook-Secret / ?secret= / body.webhookSecret / HMAC headers.
# GRAVEMINT_WEBHOOK_SECRET=

# Neon PostgreSQL — Discord logins, wallet linking (Verify), holders Discord names + merge by user, Pairs state. Run: npm run db:migrate
# Use sslmode=verify-full to avoid pg SSL warning (not sslmode=require)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=verify-full
